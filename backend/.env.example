# Spring Boot Backend Environment Configuration
# Copy this file to backend/.env and replace placeholders.
# Do NOT commit backend/.env to Git.

# Active Spring Profile: 'supabase' for hosted Supabase DB, 'postgres' for local DB
SPRING_PROFILES_ACTIVE=supabase

# Supabase Session Pooler (IPv4 compatible, Port 5432 with SSL)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.ocbloisbsincewtvspvg
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# Server Settings
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# Firebase Admin SDK Configuration
FIREBASE_ENABLED=true
# Path to service-account JSON or raw credentials JSON string (choose one)
FIREBASE_CONFIG_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
# Token revocation check (default false for fast stateless checks, true for strict session invalidation)
FIREBASE_CHECK_REVOKED=false

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# One-Time First-Owner Bootstrap (Keep disabled in standard operation)
APP_BOOTSTRAP_FIRST_OWNER_ENABLED=false
APP_BOOTSTRAP_FIRST_OWNER_SECRET=


